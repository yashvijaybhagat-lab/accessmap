rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }
    // Admin status lives in /admins/{uid} — writable only via Firebase Console
    function isAdmin() {
      return isAuthed() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function validScore(v) {
      return v is number && v >= 0 && v <= 10;
    }
    function validScores(s) {
      return s.keys().hasAll(['mobility','sensory','hearing','vision'])
        && validScore(s.mobility) && validScore(s.sensory)
        && validScore(s.hearing)  && validScore(s.vision);
    }
    function validReview() {
      let d = request.resource.data;
      return d.keys().hasAll(['placeId','userId','body','scores','createdAt','status'])
        && d.body is string
        && d.body.size() >= 10
        && d.body.size() <= 2000
        && d.userId == request.auth.uid
        && validScores(d.scores)
        && (d.status == 'approved' || d.status == 'hidden');
    }
    // Matches what the app actually writes (lib/data.ts addAlert). The old
    // version required a `body` field the app never sends, so every report failed.
    // Clients may only post community reports — "agency" alerts can't be spoofed.
    function validAlert() {
      let d = request.resource.data;
      return d.keys().hasAll(['placeId','type','description','reportedBy','createdAt','status','source'])
        && d.keys().hasOnly(['placeId','type','description','reportedBy','photoUrl','aiVerified','aiConfidence','createdAt','status','source'])
        && d.placeId is string && d.placeId.size() > 0 && d.placeId.size() <= 200
        && d.type in ['elevator','ramp','bathroom','noise','obstruction','other']
        && d.description is string && d.description.size() >= 5 && d.description.size() <= 500
        && d.reportedBy is string && d.reportedBy.size() <= 100
        && (!('photoUrl' in d) || (d.photoUrl is string && d.photoUrl.size() <= 2000))
        && (!('aiVerified' in d) || d.aiVerified is bool)
        && (!('aiConfidence' in d) || (d.aiConfidence is number && d.aiConfidence >= 0 && d.aiConfidence <= 1))
        && d.createdAt == request.time
        && d.status == 'active'
        && d.source == 'community';
    }
    function validSpec() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.placeId is string;
    }

    // ── Admins (read-only from client) ────────────────────────────────────────
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ── Places ────────────────────────────────────────────────────────────────
    match /places/{placeId} {
      allow read: if true;
      allow create: if isAuthed();
      allow update, delete: if isAdmin();

      // Reviews
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthed() && validReview();
        allow update: if isAdmin();
        allow delete: if isOwner(resource.data.userId) || isAdmin();
      }

      // Specs
      match /specs/{specId} {
        allow read: if true;
        allow create: if isAuthed() && validSpec();
        allow update, delete: if isOwner(resource.data.userId) || isAdmin();
      }
    }

    // Community specs are public; this lets search results read them for many
    // places in one collection-group query (writes still go through the rule above).
    match /{path=**}/specs/{specId} {
      allow read: if true;
    }

    // ── Alerts ────────────────────────────────────────────────────────────────
    match /alerts/{alertId} {
      allow read: if true;
      allow create: if isAuthed() && validAlert();
      allow update, delete: if isAdmin();
    }

    // ── User profiles ─────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Deny everything not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
